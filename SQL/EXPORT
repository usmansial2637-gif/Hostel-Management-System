,p_title=>'Search Results'
,p_template=>4073835273271169698
,p_display_sequence=>30
,p_region_template_options=>'#DEFAULT#:t-Region--scrollBody'
,p_component_template_options=>'#DEFAULT#:t-Report--altRowsDefault:t-Report--rowHighlight'
,p_source_type=>'NATIVE_SQL_REPORT'
,p_query_type=>'SQL'
,p_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'SELECT type, name, detail, extra',
'FROM (',
'    -- Search Students by name or reg number',
'    SELECT ''Student'' AS type,',
'           full_name AS name,',
'           reg_number AS detail,',
'           contact AS extra',
'    FROM STUDENT',
'    WHERE UPPER(full_name)',
'    LIKE UPPER(''%''||:P33_SEARCH||''%'')',
'    OR UPPER(reg_number)',
'    LIKE UPPER(''%''||:P33_SEARCH||''%'')',
'',
'    UNION ALL',
'',
'    -- Search Rooms by room number or block',
'    SELECT ''Room'' AS type,',
'           room_number AS name,',
'           room_type AS detail,',
'           status AS extra',
'    FROM ROOM',
'    WHERE UPPER(room_number)',
'    LIKE UPPER(''%''||:P33_SEARCH||''%'')',
'    OR UPPER(block)',
'    LIKE UPPER(''%''||:P33_SEARCH||''%'')',
'',
'    UNION ALL',
'',
'    -- Search Staff by name or role',
'    SELECT ''Staff'' AS type,',
'           full_name AS name,',
'           role AS detail,',
'           contact AS extra',
'    FROM STAFF',
'    WHERE UPPER(full_name)',
'    LIKE UPPER(''%''||:P33_SEARCH||''%'')',
'    OR UPPER(role)',
'    LIKE UPPER(''%''||:P33_SEARCH||''%'')',
'',
'    UNION ALL',
'',
'    -- Search Complaints by CATEGORY ONLY',
'    SELECT ''Complaint'' AS type,',
'           category AS name,',
'           description AS detail,',
'           status AS extra',
'    FROM COMPLAINT',
'    WHERE UPPER(category)',
'    LIKE UPPER(''%''||:P33_SEARCH||''%'')',
'',
'    UNION ALL',
'',
'    -- Search Maintenance by priority or status',
'    SELECT ''Maintenance'' AS type,',
'           priority AS name,',
'           description AS detail,',
'           status AS extra',
'    FROM MAINTENANCE',
'    WHERE UPPER(priority)',
'    LIKE UPPER(''%''||:P33_SEARCH||''%'')',
'    OR UPPER(status)',
